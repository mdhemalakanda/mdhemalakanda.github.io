{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "TeamzLab FedEx Shipping for WooCommerce — Live Admin Demo",
    "author": "TeamzLab",
    "description": "Preconfigured WordPress with WooCommerce and the TeamzLab FedEx Shipping plugin installed and activated. No real FedEx credentials are configured; shipping rates cannot be quoted and no real shipments or labels can be created."
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/wp-admin/admin.php?page=fedex_shipping",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "woocommerce_store_address": "123 Demo Street",
        "woocommerce_store_city": "Demo City",
        "woocommerce_default_country": "US:CA",
        "woocommerce_store_postcode": "90001",
        "woocommerce_onboarding_profile": {
          "skipped": 1
        },
        "woocommerce_task_list_hidden": "yes",
        "woocommerce_extended_task_list_hidden": "yes",
        "woocommerce_allow_tracking": "no",
        "woocommerce_review_welcome_modal_offset": "-9999px",
        "woocommerce_show_marketplace_suggestions": "no",
        "_transient__wc_activation_redirect": "",
        "_transient_timeout__wc_activation_redirect": "1",
        "fshipping_demo_seed_enabled": "yes"
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/mdhemalakanda/mdhemalakanda.github.io/main/demo/teamzlab-fedex.1.2.4.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/mdhemalakanda/mdhemalakanda.github.io/main/demo/teamzlab-fedex-demo-data.1.3.0.zip"
      },
      "options": {
        "activate": true
      }
    }
  ]
}